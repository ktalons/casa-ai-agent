{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "projectVersion": "4.0.0",
  "projectName": "CASA - Cybersecurity Analysis Support Agent",
  "env": {
    "PAI_DIR": "$HOME/.claude",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "80000",
    "BASH_DEFAULT_TIMEOUT_MS": "600000"
  },
  "daidentity": {
    "name": "CASA",
    "fullName": "Cybersecurity Analysis Support Agent",
    "displayName": "CASA",
    "color": "#10B981",
    "voiceId": "",
    "voice": {
      "stability": 0.35,
      "similarity_boost": 0.8,
      "style": 0.9,
      "speed": 1.0,
      "use_speaker_boost": true,
      "volume": 0.8
    },
    "startupCatchphrase": "CASA ready. How can I assist your investigation?"
  },
  "principal": {
    "name": "Analyst",
    "timezone": "UTC"
  },
  "project": {
    "description": "AI-Assisted Cybersecurity Analysis Agent for SME/MSP security operations",
    "version": "4.0.0",
    "standards": [
      "NIST SP 800-92",
      "NIST SP 800-61",
      "NIST CSF 2.0",
      "NIST AI RMF"
    ]
  },
  "agents": {
    "custom": [
      {
        "name": "Overseer",
        "description": "Core orchestration - routes queries to specialized agents",
        "file": "agents/Overseer.md"
      },
      {
        "name": "LogAnalyst",
        "description": "Log investigation using NIST SP 800-92 principles",
        "file": "agents/LogAnalyst.md"
      },
      {
        "name": "NetworkAnalyst",
        "description": "PCAP and network flow analysis",
        "file": "agents/NetworkAnalyst.md"
      },
      {
        "name": "PurpleTeamMapper",
        "description": "Maps findings to NIST CSF 2.0 improvements",
        "file": "agents/PurpleTeamMapper.md"
      },
      {
        "name": "Pentester",
        "description": "Authorized vulnerability assessment and security testing",
        "file": "agents/Pentester.md"
      }
    ]
  },
  "techStack": {
    "packageManager": "bun",
    "language": "TypeScript"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "NotebookRead",
      "TodoWrite",
      "Task",
      "Skill",
      "ExitPlanMode"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /:*)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf /:*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ~/.claude)",
      "Bash(rm -rf ~/.claude:*)",
      "Bash(diskutil eraseDisk:*)",
      "Bash(diskutil zeroDisk:*)",
      "Bash(diskutil partitionDisk:*)",
      "Bash(diskutil apfs deleteContainer:*)",
      "Bash(diskutil apfs eraseVolume:*)",
      "Bash(dd if=/dev/zero:*)",
      "Bash(mkfs:*)",
      "Bash(gh repo delete:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)"
    ],
    "ask": [
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*.pem)",
      "Read(~/.aws/credentials)",
      "Read(~/.gnupg/private*)",
      "Write(~/.claude/settings.json)",
      "Edit(~/.claude/settings.json)",
      "Write(~/.ssh/*)",
      "Edit(~/.ssh/*)",
      "Bash(gh repo edit --visibility public:*)"
    ],
    "defaultMode": "default"
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PAI_DIR}/hooks/SecurityValidator.hook.ts"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${PAI_DIR}/hooks/SecurityValidator.hook.ts"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${PAI_DIR}/hooks/SecurityValidator.hook.ts"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${PAI_DIR}/hooks/SecurityValidator.hook.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PAI_DIR}/hooks/StartupGreeting.hook.ts"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PAI_DIR}/hooks/SessionSummary.hook.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PAI_DIR}/hooks/StopOrchestrator.hook.ts"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PAI_DIR}/hooks/AgentOutputCapture.hook.ts"
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true,
  "_docs": {
    "_overview": "settings.template.json - CASA default configuration. setup.sh copies this to settings.json, replaces ${PAI_DIR} in hook commands with the absolute install path, and fills in principal/voice choices. Do not put secrets here; those live in .claude/.env (gitignored).",
    "_sections": {
      "daidentity": "AI identity - CASA. voiceId empty = voice disabled. Free-tier ElevenLabs verified voices: Sarah EXAVITQu4vr4xnSDxMaL, Adam pNInz6obpgDQGcFmaJgB.",
      "principal": "Analyst identity. setup.sh sets name and IANA timezone (abbreviations like PST break timestamp code).",
      "agents": "The five CASA agents: Overseer, LogAnalyst, NetworkAnalyst, PurpleTeamMapper, Pentester.",
      "permissions": "Read-only tools allowed; destructive commands denied outright; sensitive reads ask. Write/Edit/Bash prompt by default - SecurityValidator.hook.ts is the second layer.",
      "hooks": "Five hooks: SecurityValidator (PreToolUse gate), StartupGreeting, SessionSummary, StopOrchestrator (voice + capture), AgentOutputCapture (audit trail)."
    }
  }
}
