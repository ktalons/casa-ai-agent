{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ktalons/casa-ai-agent/intake/schema/soc-intake.v1.schema.json",
  "title": "talonsoclab.soc-intake/v1",
  "description": "Structured handoff from the TalonSocLab data plane to the CASA reasoning plane. Emitted by deploy/soc-recon/digest/generate_digest.py in ktalons/talonsoclab. v1 is frozen: any field change means a v2 schema and new fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated", "source", "consumer", "detections", "recon_delta", "note"],
  "properties": {
    "schema": {
      "const": "talonsoclab.soc-intake/v1"
    },
    "generated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "UTC date the intake was built (YYYY-MM-DD)"
    },
    "source": {
      "type": "string",
      "description": "Producing system, normally 'talonsoclab'"
    },
    "consumer": {
      "type": "string",
      "description": "Intended consumer, normally 'casa-ai-agent (github.com/ktalons/casa-ai-agent)'"
    },
    "detections": {
      "type": "array",
      "description": "Normalized Wazuh alerts. Live intakes default to rule.level >= 12 within a 24h lookback, max 200, newest first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "description", "rule_id", "agent", "mitre", "timestamp"],
        "properties": {
          "level": { "type": "integer", "minimum": 0, "maximum": 16 },
          "description": { "type": "string", "minLength": 1 },
          "rule_id": { "type": "string", "minLength": 1 },
          "agent": { "type": "string", "minLength": 1 },
          "mitre": { "type": "array", "items": { "type": "string", "pattern": "^T\\d{4}(\\.\\d{3})?$" } },
          "timestamp": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recon_delta": {
      "type": "string",
      "description": "Newest attack-surface delta from the recon triage queue, verbatim markdown"
    },
    "note": {
      "type": "string"
    }
  }
}
