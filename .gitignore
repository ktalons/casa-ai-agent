# macOS
.DS_Store

# Editor cruft
*.swp
*.swo
.idea/
.vscode/

# Dependencies
node_modules/

# ── .claude/ allowlist ─────────────────────────────────────────────
# ~/.claude is a symlink into this repo, so Claude Code writes runtime
# state (OAuth credentials, session logs, plugin caches, local settings)
# directly into the working tree. Ignore everything under .claude/ by
# default and re-track only the source files below. New runtime files
# Claude Code invents in the future are ignored automatically.
.claude/*
!.claude/CLAUDE.md
!.claude/settings.template.json
!.claude/agents/
!.claude/skills/
!.claude/hooks/
!.claude/security/
!.claude/VoiceServer/

# MEMORY: track the scaffold READMEs, never the captured contents
!.claude/MEMORY/
.claude/MEMORY/*
!.claude/MEMORY/README.md
!.claude/MEMORY/LEARNING/
.claude/MEMORY/LEARNING/*
!.claude/MEMORY/LEARNING/README.md
!.claude/MEMORY/RESEARCH/
.claude/MEMORY/RESEARCH/*
!.claude/MEMORY/RESEARCH/README.md
!.claude/MEMORY/STATE/
.claude/MEMORY/STATE/*
!.claude/MEMORY/STATE/README.md
!.claude/MEMORY/WORK/
.claude/MEMORY/WORK/*
!.claude/MEMORY/WORK/README.md

# Secrets — never commit (applies inside allowlisted dirs too)
.env
.env.*
*.key
*.pem
!*.example

# Logs and local artifacts
*.log
*.jsonl
!intake/raw/*.jsonl
