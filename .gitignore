# macOS / editors
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Dependencies
node_modules/

# Claude Code local state: keep only the project settings and dev notes
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json

# CASA run outputs (analyst briefs, grades, proposed detections, learn candidates)
briefs/*
!briefs/README.md
evals/results/*
!evals/results/.gitkeep
detections/proposed/*
learn/pending/*
learn/archive/*
engagements/*
!engagements/README.md

# Secrets — never commit
.env
.env.*
*.key
*.pem
!*.example

# Logs and local artifacts
*.log
*.jsonl
!intake/raw/*.jsonl
