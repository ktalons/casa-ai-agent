{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ktalons/casa-ai-agent/schemas/engagement-scope.v1.schema.json",
  "title": "casa.engagement-scope/v1",
  "description": "The authorization artifact the pentester stub requires at engagements/<slug>/scope.json. Every field must be present and non-empty; the agent refuses otherwise.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "slug", "client", "authorized_by", "authorization_date", "window", "in_scope", "out_of_scope", "rules_of_engagement"],
  "properties": {
    "schema": { "const": "casa.engagement-scope/v1" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "client": { "type": "string", "minLength": 1 },
    "authorized_by": { "type": "string", "minLength": 1, "description": "Name and role of the person who signed the authorization" },
    "authorization_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "window": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": { "start": { "type": "string", "minLength": 1 }, "end": { "type": "string", "minLength": 1 } }
    },
    "in_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "out_of_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rules_of_engagement": { "type": "string", "minLength": 1 }
  }
}
